my .gitignore has this code # Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

yarn.lock
# Keep package-lock.json actually - if you use npm, REMOVE this line above.
# It's better to commit it. For yarn/pnpm, commit their lock files too.

# Env variables - MOST IMPORTANT
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# Build / Dist
dist/
build/

# Logs
logs/
*.log
logs
pids/
*.pid
*.seed
*.pid.lock

# Runtime data
pids
*.pid
*.seed
*.pid.lock
coverage/
.nyc_output

# Uploads - if you handle file uploads locally
uploads/
public/uploads/
temp/

# Database
*.sqlite
*.sqlite3
*.db

# OS Files
.DS_Store
Thumbs.db
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.env.example

# Testing
coverage/
.nyc_output/

# Misc
.cache/
.tmp/